{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-sample-dev-india"
		},
		"LS_BLOB_SQLSERVER_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_BLOB_SQLSERVER'"
		},
		"LS_SqlServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SqlServer1'"
		},
		"ls_AzureBlobStorage1_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_AzureBlobStorage1'"
		},
		"LS_BLOB_SQLSERVER_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SUMEKA\\SQLEXPRESS"
		},
		"LS_BLOB_SQLSERVER_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sampledb"
		},
		"LS_BLOB_SQLSERVER_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqlserver001"
		},
		"LS_SqlServer1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "SUMEKA\\SQLEXPRESS"
		},
		"LS_SqlServer1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sampledb"
		},
		"LS_SqlServer1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqlserver001"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-sample-dev-india_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_AzureBlobStorage1_connectionString": {
						"value": "[parameters('ls_AzureBlobStorage1_connectionString')]"
					},
					"LS_BLOB_SQLSERVER_password": {
						"value": "[parameters('LS_BLOB_SQLSERVER_password')]"
					},
					"LS_SqlServer1_password": {
						"value": "[parameters('LS_SqlServer1_password')]"
					},
					"LS_BLOB_SQLSERVER_properties_typeProperties_server": {
						"value": "[parameters('LS_BLOB_SQLSERVER_properties_typeProperties_server')]"
					},
					"LS_BLOB_SQLSERVER_properties_typeProperties_database": {
						"value": "[parameters('LS_BLOB_SQLSERVER_properties_typeProperties_database')]"
					},
					"LS_BLOB_SQLSERVER_properties_typeProperties_userName": {
						"value": "[parameters('LS_BLOB_SQLSERVER_properties_typeProperties_userName')]"
					},
					"LS_SqlServer1_properties_typeProperties_server": {
						"value": "[parameters('LS_SqlServer1_properties_typeProperties_server')]"
					},
					"LS_SqlServer1_properties_typeProperties_database": {
						"value": "[parameters('LS_SqlServer1_properties_typeProperties_database')]"
					},
					"LS_SqlServer1_properties_typeProperties_userName": {
						"value": "[parameters('LS_SqlServer1_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}